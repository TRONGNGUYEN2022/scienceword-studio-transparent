<Window x:Class="ScienceWordWebViewOverlay.FloatingDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Left="180"
        Top="6">
    <Border Background="#F00F172A" BorderBrush="#60A5FA" BorderThickness="1.5" CornerRadius="10" Padding="8,5" Margin="4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="⋮⋮ WV2 Overlay" Foreground="#FBBF24" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="SizeAll" MouseLeftButtonDown="Grip_MouseLeftButtonDown"/>
            <TextBlock x:Name="TxtApp" Text="Đích: Tự động" Foreground="#7DD3FC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ToggleButton x:Name="BtnPass" Content="🖱️ Xuyên chuột" Padding="8,3" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Cursor="Hand" Checked="BtnPass_Checked" Unchecked="BtnPass_Unchecked"/>
            <Button Content="✕ Thoát" Padding="8,3" FontSize="11" FontWeight="Bold" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnExit_Click"/>
        </StackPanel>
    </Border>
</Window>
